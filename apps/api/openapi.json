{
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "question": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/ScopeInfo"
          }
        },
        "required": [
          "question",
          "scope"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "Body_upload_video_v1_videos_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_video_v1_videos_post",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "JobCreate": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          }
        },
        "required": [
          "kind"
        ],
        "title": "JobCreate",
        "type": "object"
      },
      "JobKind": {
        "enum": [
          "probe",
          "indexing"
        ],
        "title": "JobKind",
        "type": "string"
      },
      "JobOut": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finishedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finishedat"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "progress": {
            "title": "Progress",
            "type": "number"
          },
          "startedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Startedat"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "videoId": {
            "title": "Videoid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "videoId",
          "kind",
          "status",
          "progress",
          "createdAt"
        ],
        "title": "JobOut",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "ScopeInfo": {
        "properties": {
          "duration": {
            "minimum": 0.0,
            "title": "Duration",
            "type": "number"
          },
          "end": {
            "minimum": 0.0,
            "title": "End",
            "type": "number"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "start": {
            "minimum": 0.0,
            "title": "Start",
            "type": "number"
          },
          "videoId": {
            "minLength": 1,
            "title": "Videoid",
            "type": "string"
          },
          "videoName": {
            "title": "Videoname",
            "type": "string"
          }
        },
        "required": [
          "videoId",
          "videoName",
          "start",
          "end",
          "duration",
          "label"
        ],
        "title": "ScopeInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VideoOut": {
        "properties": {
          "codec": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Codec"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "durationSec": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationsec"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "fps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fps"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sizeBytes": {
            "title": "Sizebytes",
            "type": "integer"
          },
          "src": {
            "description": "Path (relative to the API origin) the player loads the video from.",
            "readOnly": true,
            "title": "Src",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/VideoStatus"
          },
          "thumbnailSrc": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "readOnly": true,
            "title": "Thumbnailsrc"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          }
        },
        "required": [
          "id",
          "name",
          "filename",
          "sizeBytes",
          "status",
          "createdAt",
          "src",
          "thumbnailSrc"
        ],
        "title": "VideoOut",
        "type": "object"
      },
      "VideoStatus": {
        "enum": [
          "uploaded",
          "ready",
          "failed"
        ],
        "title": "VideoStatus",
        "type": "string"
      }
    }
